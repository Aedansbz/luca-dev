# =============================================================================
# OnlineShop-Compose — local/dev env template (NO real secrets)
# Copy to `.env` and fill blank passwords and keys. Use a random JWT_KEY of at least 64 bytes. Never commit `.env`.
# docker-compose.dev.yml loads this file via env_file for every service.
# =============================================================================

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=OnlineShopDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ─── JWT / ASP.NET (Jwt__* is what the API reads) ───────────────────────────
JWT_KEY=
Jwt__Key=${JWT_KEY}
Jwt__Issuer=OnlineShop
Jwt__Audience=OnlineShopUsers
JWT_ISSUER=OnlineShop
JWT_AUDIENCE=OnlineShopUsers

# ─── Backend (ASP.NET) ──────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
BACKEND_PORT=8080
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=OnlineShopDb;Username=postgres;Password=${POSTGRES_PASSWORD}
Seed__AdminEmail=admin@lucaloupe.local
Seed__AdminPassword=
Hangfire__DashboardEnabled=true
Backup__Directory=/src/Api/backups
Backup__PgDumpPath=pg_dump
ContentAutomation__AdminBaseUrl=http://localhost:3000
ContentAutomation__ServiceAccountName=Content Admin
ContentAutomation__ServiceAccountEmail=content-bot@onlineshop.local
ContentAutomation__ServiceAccountPassword=
# X-Api-Key for catalog writes (production n8n uses the same value). Never commit the real key.
ContentAutomation__ApiKey=

# ─── Frontend (Next.js) ─────────────────────────────────────────────────────
NODE_ENV=development
INTERNAL_SERVER_SIDE_API_URL=http://backend:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Luca Loupe

# ─── Docker / Domain ────────────────────────────────────────────────────────
DOCKER_USERNAME=your-dockerhub-username
COMPOSE_PROJECT_NAME=shop
DOMAIN_NAME=localhost
CERTBOT_EMAIL=you@example.com
PORTAINER_PORT=9000

# ─── pgAdmin ────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_CONFIG_SERVER_MODE=False
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=${PGADMIN_DEFAULT_PASSWORD}

TZ=Asia/Tehran

# SEO ops (backend health probes must reach these from inside Docker)
SeoOps__SitePublicUrl=http://frontend:3000
SeoOps__ApiPublicUrl=http://backend:8080
